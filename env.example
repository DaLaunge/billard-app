# Kopie dieser Datei heisst ".env" (nur fuer lokale Entwicklung noetig).
# Bei Vercel traegst du diese beiden Werte als Environment Variables ein.
VITE_SUPABASE_URL=https://DEIN-PROJEKT.supabase.co
VITE_SUPABASE_ANON_KEY=DEIN-ANON-KEY
# Oeffentlicher VAPID-Schluessel fuer Push-Nachrichten (siehe PUSH_ANLEITUNG.md).
# Ohne ihn bietet die App "Auch im Hintergrund" nicht an.
VITE_VAPID_PUBLIC_KEY=DEIN-VAPID-PUBLIC-KEY
