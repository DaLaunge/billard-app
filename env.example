# Kopie dieser Datei heisst ".env" (nur fuer lokale Entwicklung noetig).
# Bei Vercel traegst du diese Werte als Environment Variables ein.
VITE_SUPABASE_URL=https://DEIN-PROJEKT.supabase.co
VITE_SUPABASE_ANON_KEY=DEIN-ANON-KEY
# Cloudflare Turnstile Site-Key (oeffentlich, kein Geheimnis) - schuetzt den
# Gast-Login (Anonymous Sign-In) vor Bot-Missbrauch. Der zugehoerige Secret-Key
# steht NICHT hier, sondern nur im Supabase-Dashboard (Authentication ->
# Attack Protection). Ohne diese Variable wird kein Captcha angezeigt und
# "Als Gast spielen" ist deaktiviert, sobald Supabase Captcha-Pflicht verlangt.
VITE_TURNSTILE_SITE_KEY=DEIN-TURNSTILE-SITE-KEY
